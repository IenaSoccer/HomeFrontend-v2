{
  "name": "homefrontend",
  "version": "1.0.0",
  "description": "Iena Soccer Homepage",
  "productName": "Iena Soccer",
  "author": "ErPaciocco <erpaciocco.smhacko@protonmail.com>",
  "type": "module",
  "private": true,
  "scripts": {
    "type-check": "vue-tsc --noEmit --project tsconfig.json",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "echo \"No test specified\" && exit 0",
    "dev": "quasar dev",
    "dev:ssr": "quasar dev -m ssr",
    "build": "quasar build",
    "build:ssr": "quasar build -m ssr",
    "start:ssr": "quasar serve -m ssr dist/ssr",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^1.16.4",
    "@splidejs/vue-splide": "^0.6.12",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.2.2",
    "axios": "^1.2.1",
    "compression": "^1.8.1",
    "express": "^5.1.0",
    "pinia": "^3.0.1",
    "quasar": "^2.19.2",
    "vue": "^3.4.18",
    "vue-router": "^4.0.12"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^2.5.4",
    "@types/compression": "^1.8.1",
    "@types/express": "^5.0.3",
    "@types/node": "^20.5.9",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.4.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^9.30.0",
    "globals": "^15.12.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite-plugin-checker": "^0.9.0",
    "vue-tsc": "^2.2.10"
  },
  "engines": {
    "node": "^28 || ^26 || ^24 || ^22 || ^20 || ^18",
    "npm": ">= 6.13.4",
    "yarn": ">= 1.21.1"
  }
}
