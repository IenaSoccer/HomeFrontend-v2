{
  "name": "homefrontend",
  "version": "1.0.0",
  "description": "Iena Soccer Homepage",
  "productName": "Iena Soccer",
  "author": "ErPaciocco <erpaciocco.smhacko@protonmail.com>",
  "type": "module",
  "private": true,
  "packageManager": "npm@10.9.4",
  "scripts": {
    "type-check": "vue-tsc --noEmit --project tsconfig.json",
    "lint": "eslint -c ./eslint.config.js \"./src*/**/*.{ts,js,cjs,mjs,vue}\"",
    "format": "prettier --write \"**/*.{js,ts,vue,scss,html,md,json}\" --ignore-path .gitignore",
    "test": "npm run lint && npm run type-check",
    "dev": "quasar dev",
    "dev:ssr": "quasar dev -m ssr",
    "build": "quasar build",
    "build:ssr": "quasar build -m ssr",
    "start:ssr": "quasar serve -m ssr dist/ssr",
    "postinstall": "quasar prepare"
  },
  "dependencies": {
    "@quasar/extras": "^2.1.0",
    "@splidejs/vue-splide": "^0.6.12",
    "axios": "^1.13.2",
    "pinia": "^3.0.1",
    "quasar": "^2.35.4",
    "sanitize-html": "^2.17.0",
    "vue": "^3.5.22",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.14.0",
    "@quasar/app-vite": "^3.10.4",
    "@tailwindcss/postcss": "^4.1.12",
    "@tailwindcss/vite": "^4.3.5",
    "@types/node": "^22.20.5",
    "@types/sanitize-html": "^2.16.2",
    "@vue/eslint-config-prettier": "^10.1.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.14.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^16.4.0",
    "postcss": "^8.5.6",
    "prettier": "^3.3.3",
    "tailwindcss": "^4.1.12",
    "typescript": "~5.9.2",
    "vite-plugin-checker": "^0.11.0",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.0.7"
  },
  "engines": {
    "node": "^22.22.0 || ^24 || ^26 || ^28 || >=30",
    "npm": "^10.9.4"
  }
}
