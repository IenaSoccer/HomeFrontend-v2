{
  "extends": "./.quasar/tsconfig.json",
  "compilerOptions": {
    "baseUrl": ".",
    "noImplicitAny": false,
    "paths": {
      "#components/*": ["src/components/*"],
      "#layouts/*": ["src/layouts/*"],
      "#pages/*": ["src/pages/*"],
      "#boot/*": ["src/boot/*"]
    },
    "types": ["quasar"]
  },
  "include": [
    ".quasar/**/*.ts",
    ".quasar/**/*.d.ts",
    "quasar.config.ts",
    "src/**/*.ts",
    "src/**/*.d.ts",
    "src/**/*.vue",
    "src-ssr/**/*.ts"
  ],
  "typeRoots": ["./node_modules/@types", "./.quasar"]
}
